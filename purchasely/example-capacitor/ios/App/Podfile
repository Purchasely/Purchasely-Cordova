require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CordovaPluginsStatic', :path => '../capacitor-cordova-ios-plugins'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

# The AppTests unit-test bundle is hosted by App, but it still needs the pod headers at
# compile time (CDVPurchasely.h, and CDVPlugin.h behind it). Declared outside
# `def capacitor_pods` on purpose: `npx cap sync` rewrites only that def's body
# (@capacitor/cli, cli/src/ios/update.ts), so this block survives a sync.
target 'AppTests' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
