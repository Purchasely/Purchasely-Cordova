<?xml version='1.0' encoding='utf-8'?>
<plugin id="@purchasely/cordova-plugin-purchasely-google" version="6.0.0-rc.1" xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>PurchaselyGoogle</name>
    <js-module name="PurchaselyGoogle" src="www/PurchaselyGoogle.js">
        <clobbers target="cordova.plugins.PurchaselyGoogle" />
    </js-module>
    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="PurchaselyGoogle">
                <param name="android-package" value="cordova-plugin-purchasely-google.PurchaselyGoogle" />
            </feature>
        </config-file>
        <config-file parent="/*" target="AndroidManifest.xml">
        </config-file>
        <!-- v6 testing pin: kept in lockstep with io.purchasely:core:6.0.0-beta.12
             (resolved from mavenLocal). Restore to the published 6.0.0 string before release. -->
        <framework src="io.purchasely:google-play:6.0.0-beta.12" />
        <source-file src="src/android/PurchaselyGoogle.java" target-dir="src/cordova-plugin-purchasely-google/PurchaselyGoogle" />
    </platform>
</plugin>
